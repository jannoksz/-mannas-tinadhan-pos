# Copy this file to .env and fill in your Supabase project credentials
# (Project Settings → API in your Supabase dashboard)

# ⚠️ Use the SERVICE ROLE key here, not the anon/public key.
#    The backend needs full read/write access and this key must
#    never be exposed to the frontend or committed to git.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional — Render (and most hosts) set this automatically.
# Only needed for local overrides.
# PORT=3000
